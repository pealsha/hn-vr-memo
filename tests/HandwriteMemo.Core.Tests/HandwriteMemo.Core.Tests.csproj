<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <Compile Include="../TestAssert.cs" Link="TestAssert.cs" />
    <Compile Include="../TestOutput.cs" Link="TestOutput.cs" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="HandwriteMemo.Testing.TestAssert" Static="true" />
    <ProjectReference Include="..\..\src\HandwriteMemo.Core\HandwriteMemo.Core.csproj" />
  </ItemGroup>
</Project>
