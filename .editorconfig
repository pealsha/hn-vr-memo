root = true

# Only handwritten product and test C# sources; no repository-wide reformat.
[{src,tests}/**/*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.fields.symbols = fields
dotnet_naming_rule.fields.style = instance_field
dotnet_naming_rule.fields.severity = warning
dotnet_naming_symbols.fields.applicable_kinds = field
dotnet_naming_symbols.fields.applicable_accessibilities = private
dotnet_naming_style.instance_field.required_prefix = _
dotnet_naming_style.instance_field.capitalization = camel_case

dotnet_naming_rule.static_fields.symbols = static_fields
dotnet_naming_rule.static_fields.style = static_field
dotnet_naming_rule.static_fields.severity = warning
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.applicable_accessibilities = private
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_style.static_field.required_prefix = s_
dotnet_naming_style.static_field.capitalization = camel_case

# Exposed members use PascalCase. Prefer properties to non-private fields.
dotnet_naming_rule.exposed_members.symbols = exposed_members
dotnet_naming_rule.exposed_members.style = constant
dotnet_naming_rule.exposed_members.severity = warning
dotnet_naming_symbols.exposed_members.applicable_kinds = field, property
dotnet_naming_symbols.exposed_members.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

# const is implicitly static: this intersection takes priority over static_fields.
dotnet_naming_rule.field_constants.symbols = field_constants
dotnet_naming_rule.field_constants.style = constant
dotnet_naming_rule.field_constants.severity = warning
dotnet_naming_symbols.field_constants.applicable_kinds = field
dotnet_naming_symbols.field_constants.applicable_accessibilities = private, internal
dotnet_naming_symbols.field_constants.required_modifiers = const
dotnet_naming_style.constant.capitalization = pascal_case

dotnet_naming_rule.local_constants.symbols = local_constants
dotnet_naming_rule.local_constants.style = constant
dotnet_naming_rule.local_constants.severity = warning
dotnet_naming_symbols.local_constants.applicable_kinds = local
dotnet_naming_symbols.local_constants.applicable_accessibilities = local
dotnet_naming_symbols.local_constants.required_modifiers = const

[{src,tests}/**/*.{g,generated,Generated}.cs]
generated_code = true
dotnet_diagnostic.IDE1006.severity = none

[{src,tests}/**/obj/**/*.cs]
generated_code = true
dotnet_diagnostic.IDE1006.severity = none
